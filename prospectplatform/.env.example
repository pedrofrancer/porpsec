DATABASE_URL=sqlite:///./prospectplatform.db

# LLM (Groq free tier: https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk-sua-chave-aqui
LLM_MODEL=llama-3.3-70b-versatile

# WhatsApp (so Brasil)
DAILY_SEND_LIMIT=20

GOOGLE_MAPS_TIMEOUT=30000

# E-mail (Gmail): ative a verificacao em 2 etapas e crie uma senha de app em
# https://myaccount.google.com/apppasswords . Nunca use a senha normal da conta.
EMAIL_ADDRESS=seu.email@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_DAILY_LIMIT=20
EMAIL_HOURLY_LIMIT=6
EMAIL_WARMUP_CURVE=5,8,10,12,15,18,20

# Rodape legal (obrigatorio na UE): nome comercial e endereco postal de quem envia.
SENDER_BRAND=
SENDER_CONTACT_NAME=
SENDER_POSTAL_ADDRESS=
SENDER_WEBSITE=
# Faixa de preco citada no e-mail (vazio = nao menciona preco). Ex.: "490 EUR"
OFFER_PRICE_RANGE=

# Previa de site (Cloudflare Pages gratis). Crie o token em
# https://dash.cloudflare.com/profile/api-tokens com a permissao "Account > Cloudflare Pages > Edit".
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Nome do projeto no Pages; as previas ficam em https://<projeto>.pages.dev/p/<empresa>/
CLOUDFLARE_PAGES_PROJECT=
PREVIEW_TTL_DAYS=30
# false = previa e resposta ficam em rascunho ate voce aprovar no painel (aba Respostas)
PREVIEW_AUTO_SEND=false
# Fotos ilustrativas gratis quando a empresa nao tem fotos proprias: https://www.pexels.com/api/
PEXELS_API_KEY=

# Windows: nao deixa o PC suspender enquanto o servidor roda
KEEP_AWAKE=true
