<!DOCTYPE html>
{#- Regras deste template: prospectplatform/design-system.md. Nada de hero com gradiente,
    rotulo acima de titulo, cartao numerado, mapa embutido ou monograma. -#}
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ kit.name }} · {{ kit.city }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ fonts.url }}&display=swap" rel="stylesheet">
<style>
:root{
  --casa:{{ kit.primary }};--on-casa:{{ kit.primary|on }};
  --casa-2:{{ kit.accent }};--on-casa-2:{{ kit.accent|on }};
  --papel:{{ kit.background }};--tinta:{{ kit.text }};
  --fio:color-mix(in srgb,var(--tinta) 18%,transparent);
  --display:{{ fonts.display }};--body:{{ fonts.body }};
  --raio:{{ fonts.radius }};
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--body);background:var(--papel);color:var(--tinta);line-height:1.6;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
img{display:block;max-width:100%}
a{color:inherit}
.wrap{width:min(1080px,100% - 32px);margin-inline:auto}
.aviso{background:var(--tinta);color:var(--papel);font:13px/1.4 system-ui,sans-serif;padding:8px 16px}
header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;border-bottom:1px solid var(--fio)}
.marca{display:flex;align-items:center;gap:12px;text-decoration:none;font-family:var(--display);font-size:1.25rem;line-height:1.1}
.marca img{height:44px;width:auto;object-fit:contain}
.tel{text-decoration:none;font-weight:600;white-space:nowrap}
.btn{display:inline-block;background:var(--casa-2);color:var(--on-casa-2);padding:13px 22px;border-radius:var(--raio);text-decoration:none;font-weight:600}
.btn.linha{background:transparent;color:inherit;border:1px solid currentColor}
.abertura{display:grid;grid-template-columns:5fr 7fr;gap:48px;align-items:start;padding:56px 0 64px}
h1{font-family:var(--display);font-weight:{{ fonts.display_weight }};font-size:clamp(2.6rem,7vw,5.5rem);line-height:.98;letter-spacing:-.01em;overflow-wrap:anywhere}
.lead{font-size:1.1rem;margin-top:18px;max-width:34ch}
.nota{margin-top:14px;font-size:.95rem}
.acoes{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.objeto{padding:28px 28px 20px;border-radius:var(--raio)}
.objeto h2{font-family:var(--display);font-weight:{{ fonts.display_weight }};font-size:1.5rem;margin-bottom:14px}
.objeto ul{list-style:none}
.objeto li b{font-weight:600}
.objeto-tabela,.objeto-carta,.objeto-horario{background:var(--casa);color:var(--on-casa)}
.objeto-cartao{background:var(--papel);color:var(--tinta);border:1px solid var(--fio)}
.objeto-tabela li{display:flex;align-items:baseline;gap:10px;padding:10px 0;border-top:1px solid color-mix(in srgb,var(--on-casa) 22%,transparent)}
.objeto-tabela li i{flex:1;border-bottom:1px dotted currentColor;opacity:.5;transform:translateY(-4px)}
.objeto-tabela li span{font-size:.92rem;opacity:.85;text-align:right}
.objeto-cartao li{padding:10px 0;border-top:1px solid var(--fio)}
.objeto-cartao li span{display:block;font-size:.92rem;opacity:.75;margin-top:4px}
.objeto-carta li{padding:12px 0;border-top:1px dotted color-mix(in srgb,var(--on-casa) 30%,transparent)}
.objeto-carta li b{font-family:var(--display);font-weight:{{ fonts.display_weight }}}
.objeto-carta li span{display:block;font-style:italic;font-size:.92rem;opacity:.85;margin-top:4px}
.objeto-horario ul{display:grid;grid-template-columns:1fr 1fr;gap:0 20px}
.objeto-horario li{padding:10px 0;border-top:1px solid color-mix(in srgb,var(--on-casa) 22%,transparent)}
.objeto-horario li span{display:block;font-size:.85rem;opacity:.8;margin-top:2px}
.objeto-marcacao{display:flex;flex-direction:column;align-items:flex-start;gap:16px;background:var(--casa);color:var(--on-casa)}
.tel-grande{font-family:var(--display);font-weight:{{ fonts.display_weight }};font-size:clamp(1.6rem,4vw,2.2rem);text-decoration:none}
.objeto-livro{background:var(--casa);color:var(--on-casa)}
.objeto-livro blockquote{font-size:1.1rem;font-style:italic}
.lista-sobria{list-style:none;max-width:60ch}
.lista-sobria li{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-top:1px solid var(--fio)}
.lista-sobria b{font-weight:600}
.lista-sobria span{opacity:.75;text-align:right}
section{padding:64px 0;border-top:1px solid var(--fio)}
h2.sec{font-family:var(--display);font-weight:{{ fonts.display_weight }};font-size:clamp(1.6rem,3.5vw,2.4rem);line-height:1.1;margin-bottom:20px}
.sobre{display:grid;grid-template-columns:4fr 8fr;gap:48px}
.sobre blockquote{font-size:1.2rem;max-width:60ch}
.sobre cite{display:block;margin-top:12px;font-style:normal;font-size:.9rem;opacity:.75}
.fotos{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.fotos img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--raio)}
.rotulo{font-size:.8rem;opacity:.7;margin-top:10px}
.contato{display:grid;grid-template-columns:4fr 8fr;gap:48px}
.contato dl{display:grid;gap:14px;font-size:1.05rem;max-width:44ch}
.contato dt{font-size:.85rem;opacity:.7}
footer{padding:28px 0;font-size:.85rem;opacity:.75;border-top:1px solid var(--fio)}
@media (max-width:760px){
  .abertura,.sobre,.contato{grid-template-columns:1fr;gap:28px}
  .abertura{padding:36px 0 48px}
  .fotos{grid-template-columns:1fr 1fr}
  section{padding:48px 0}
}
</style>
</head>
<body>
<div class="aviso">{{ ui.banner }}</div>

<div class="wrap">
  <header>
    <a class="marca" href="#top">
      {% if kit.logo_url %}<img src="{{ kit.logo_url }}" alt="{{ kit.name }}">{% else %}{{ kit.name }}{% endif %}
    </a>
    {% if kit.phone %}<a class="tel" href="tel:{{ kit.phone|replace(' ', '') }}">{{ kit.phone }}</a>{% endif %}
  </header>

  <main id="top">
    <div class="abertura">
      <div>
        <h1>{{ kit.name }}</h1>
        <p class="lead">{{ copy.tagline }}</p>
        {% if rating_line %}<p class="nota">{{ rating_line }}</p>{% endif %}
        <div class="acoes">
          <a class="btn" href="{{ contact_href }}">{{ copy.cta }}</a>
          <a class="btn linha" href="{{ map_url }}" target="_blank" rel="noopener">{{ ui.open_map }}</a>
        </div>
      </div>
      {% if objeto == 'marcacao' %}
      <div class="objeto objeto-marcacao">
        {% if kit.phone %}<a class="tel-grande" href="tel:{{ kit.phone|replace(' ', '') }}">{{ kit.phone }}</a>{% endif %}
        <a class="btn" href="{{ contact_href }}">{{ copy.cta }}</a>
      </div>
      {% elif objeto == 'livro' and kit.about_snippet %}
      <div class="objeto objeto-livro">
        <blockquote>{{ quotes[0] }}{{ kit.about_snippet }}{{ quotes[1] }}</blockquote>
      </div>
      {% elif copy.services %}
      {% set objeto_lista = 'tabela' if objeto == 'livro' else objeto %}
      <div class="objeto objeto-{{ objeto_lista }}">
        <h2>{{ ui.services }}</h2>
        <ul>
          {% for title, desc in copy.services %}<li><b>{{ title }}</b>{% if objeto_lista == 'tabela' %}<i></i>{% endif %}<span>{{ desc }}</span></li>{% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>

    {% if objeto == 'marcacao' and copy.services %}
    <section>
      <h2 class="sec">{{ ui.services }}</h2>
      <ul class="lista-sobria">
        {% for title, desc in copy.services %}<li><b>{{ title }}</b><span>{{ desc }}</span></li>{% endfor %}
      </ul>
    </section>
    {% endif %}

    <section>
      <div class="sobre">
        <h2 class="sec">{{ kit.category_label|capitalize }}, {{ kit.city }}</h2>
        {% if kit.about_snippet %}
        <blockquote>{{ quotes[0] }}{{ kit.about_snippet }}{{ quotes[1] }}<cite>{{ kit.name }}</cite></blockquote>
        {% else %}
        <p class="lead">{{ copy.about }}</p>
        {% endif %}
      </div>
    </section>

    {% if photos %}
    <section>
      <div class="fotos">
        {% for photo in photos %}<img src="{{ photo.url }}" alt="{{ kit.name }}" loading="{{ 'eager' if loop.first else 'lazy' }}">{% endfor %}
      </div>
      {% if kit.stock_photos %}<p class="rotulo">{{ ui.photos_note }}</p>{% endif %}
    </section>
    {% endif %}

    <section id="contato">
      <div class="contato">
        <h2 class="sec">{{ ui.find_us }}</h2>
        <dl>
          {% if kit.address %}<div><dt>{{ ui.find_us }}</dt><dd><a href="{{ map_url }}" target="_blank" rel="noopener">{{ kit.address }}</a></dd></div>{% endif %}
          {% if kit.phone %}<div><dt>{{ ui.call }}</dt><dd><a href="tel:{{ kit.phone|replace(' ', '') }}">{{ kit.phone }}</a></dd></div>{% endif %}
          {% if kit.email %}<div><dt>{{ ui.write }}</dt><dd><a href="mailto:{{ kit.email }}">{{ kit.email }}</a></dd></div>{% endif %}
          {% if kit.instagram %}<div><dt>Instagram</dt><dd>{{ kit.instagram }}</dd></div>{% endif %}
        </dl>
      </div>
    </section>
  </main>
</div>

<footer>
  <div class="wrap">© {{ year }} {{ kit.name }} · {{ kit.city }}</div>
</footer>
</body>
</html>
