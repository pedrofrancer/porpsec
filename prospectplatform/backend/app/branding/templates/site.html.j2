<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ kit.name }} · {{ copy.tagline }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ fonts.url }}&display=swap" rel="stylesheet">
<style>
:root{
  --primary:{{ kit.primary }};--on-primary:{{ kit.primary|on }};
  --accent:{{ kit.accent }};--on-accent:{{ kit.accent|on }};
  --bg:{{ kit.background }};--fg:{{ kit.text }};
  --display:{{ fonts.display }};--body:{{ fonts.body }};
  --radius:{{ '2px' if kit.mood in ('bold','clean') else '18px' }};
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);background:var(--bg);color:var(--fg);line-height:1.6;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%}
a{color:inherit}
.wrap{width:min(1120px,100% - 40px);margin-inline:auto}
.preview-bar{background:#111;color:#f1f1f1;font:13px/1.4 system-ui,sans-serif;padding:9px 16px;text-align:center;position:sticky;top:0;z-index:10}
header.site{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 0}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.brand img{height:48px;width:auto;object-fit:contain}
.brand span{font-family:var(--display);font-size:1.45rem;letter-spacing:{{ '.06em' if kit.mood=='bold' else '0' }};{{ 'text-transform:uppercase;' if kit.mood=='bold' else '' }}}
nav.menu{display:flex;gap:26px;font-size:.95rem}
nav.menu a{text-decoration:none;opacity:.8}
nav.menu a:hover{opacity:1}
.btn{display:inline-block;background:var(--accent);color:var(--on-accent);padding:14px 26px;border-radius:var(--radius);text-decoration:none;font-weight:600;letter-spacing:.02em}
.btn.ghost{background:transparent;color:inherit;border:1.5px solid currentColor}
.hero{position:relative}
.hero h1{font-family:var(--display);font-weight:{{ '400' if kit.mood in ('bold','warm') else '600' }};line-height:1.02;letter-spacing:-.01em}
.hero p.lead{font-size:1.15rem;opacity:.85;max-width:34ch}
{% if kit.mood in ('bold','warm') %}
.hero{min-height:78vh;display:grid;align-items:end;color:#fff;background:#222 {% if kit.hero %}url('{{ kit.hero.url }}') center/cover{% endif %}}
.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.15),rgba(0,0,0,.72))}
.hero .wrap{position:relative;padding:0 0 9vh}
.hero h1{font-size:clamp(3rem,9vw,7.2rem);{{ 'text-transform:uppercase;' if kit.mood=='bold' else '' }}max-width:12ch;margin-bottom:18px}
{% else %}
.hero .wrap{display:grid;grid-template-columns:1.05fr 1fr;gap:56px;align-items:center;padding:40px 0 80px}
.hero h1{font-size:clamp(2.6rem,6vw,4.8rem);margin-bottom:20px;color:var(--primary)}
.hero figure{aspect-ratio:4/5;border-radius:var(--radius);overflow:hidden;background:linear-gradient(135deg,var(--primary),var(--accent))}
.hero figure img{width:100%;height:100%;object-fit:cover}
.hero figure .mono{height:100%;display:grid;place-items:center;font-family:var(--display);font-size:clamp(4rem,12vw,9rem);color:var(--on-primary);opacity:.9}
{% endif %}
.hero .actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}
.rating{display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-size:.95rem;opacity:.9}
.rating b{color:var(--accent)}
section{padding:96px 0}
.eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:.78rem;color:var(--accent);margin-bottom:14px;font-weight:700}
h2{font-family:var(--display);font-weight:{{ '400' if kit.mood in ('bold','warm') else '600' }};font-size:clamp(2rem,4.5vw,3.2rem);line-height:1.1;margin-bottom:28px}
.about{display:grid;grid-template-columns:1fr 1.3fr;gap:64px;align-items:start}
.about blockquote{font-size:1.25rem;line-height:1.55;border-left:3px solid var(--accent);padding-left:22px}
.band{background:var(--primary);color:var(--on-primary)}
{% if kit.mood == 'warm' %}
.services{columns:2;column-gap:64px}
.svc{break-inside:avoid;display:flex;justify-content:space-between;gap:20px;padding:18px 0;border-bottom:1px dotted currentColor}
.svc h3{font-family:var(--display);font-weight:400;font-size:1.35rem}
.svc p{opacity:.75;text-align:right}
{% else %}
.services{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2px;background:rgba(127,127,127,.25)}
.svc{background:var(--primary);padding:34px 28px}
.svc .n{font-family:var(--display);font-size:2.2rem;color:var(--accent);line-height:1}
.svc h3{font-size:1.15rem;margin:18px 0 6px}
.svc p{opacity:.78;font-size:.95rem}
{% endif %}
.gallery{display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px}
.gallery img{width:100%;height:320px;object-fit:cover;border-radius:var(--radius)}
.note{font-size:.8rem;opacity:.6;margin-top:12px}
.contact{display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:stretch}
.contact dl{display:grid;gap:18px;font-size:1.05rem}
.contact dt{font-size:.78rem;text-transform:uppercase;letter-spacing:.14em;opacity:.6}
.map{min-height:340px;border:0;width:100%;border-radius:var(--radius);filter:grayscale(.2)}
footer{padding:36px 0;font-size:.85rem;opacity:.7;border-top:1px solid rgba(127,127,127,.3)}
@media (max-width:820px){
  nav.menu{display:none}
  .hero .wrap,.about,.contact{grid-template-columns:1fr}
  .services{columns:1}
  .gallery{grid-template-columns:1fr}
  .gallery img{height:220px}
  section{padding:64px 0}
}
</style>
</head>
<body>
<div class="preview-bar">{{ ui.banner }}</div>

<div class="wrap">
  <header class="site">
    <a class="brand" href="#top">
      {% if kit.logo_url %}<img src="{{ kit.logo_url }}" alt="{{ kit.name }}">{% endif %}
      <span>{{ kit.name }}</span>
    </a>
    <nav class="menu">
      <a href="#about">{{ ui.about }}</a>
      {% if copy.services %}<a href="#services">{{ ui.services }}</a>{% endif %}
      <a href="#contact">{{ ui.contact }}</a>
    </nav>
    <a class="btn" href="#contact">{{ copy.cta }}</a>
  </header>
</div>

<main id="top">
  <div class="hero">
    <div class="wrap">
      <div>
        <h1>{{ kit.name }}</h1>
        <p class="lead">{{ copy.tagline }}</p>
        <div class="actions">
          <a class="btn" href="#contact">{{ copy.cta }}</a>
          {% if kit.phone %}<a class="btn ghost" href="tel:{{ kit.phone|replace(' ', '') }}">{{ ui.call }}</a>{% endif %}
        </div>
        {% if rating_line %}<div class="rating"><b>★</b> {{ rating_line }}</div>{% endif %}
      </div>
      {% if kit.mood not in ('bold','warm') %}
      <figure>
        {% if kit.hero %}<img src="{{ kit.hero.url }}" alt="{{ kit.name }}">{% else %}<div class="mono">{{ kit.name[:1] }}</div>{% endif %}
      </figure>
      {% endif %}
    </div>
  </div>

  <section id="about">
    <div class="wrap about">
      <div>
        <div class="eyebrow">{{ ui.about }}</div>
        <h2>{{ kit.category_label|capitalize }}, {{ kit.city }}</h2>
      </div>
      <blockquote>{{ kit.about_snippet or copy.about }}</blockquote>
    </div>
  </section>

  {% if copy.services %}
  <section id="services" class="band">
    <div class="wrap">
      <div class="eyebrow">{{ ui.services }}</div>
      <h2>{{ copy.tagline }}</h2>
      <div class="services">
        {% for title, desc in copy.services %}
        <div class="svc">
          {% if kit.mood != 'warm' %}<div class="n">{{ '%02d'|format(loop.index) }}</div>{% endif %}
          <h3>{{ title }}</h3>
          <p>{{ desc }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if kit.gallery %}
  <section>
    <div class="wrap">
      <div class="gallery">
        {% for photo in kit.gallery[:3] %}<img src="{{ photo.url }}" alt="{{ kit.category_label }}" loading="lazy">{% endfor %}
      </div>
      {% if kit.stock_photos %}<p class="note">{{ ui.photos_note }}</p>{% endif %}
    </div>
  </section>
  {% endif %}

  <section id="contact">
    <div class="wrap contact">
      <div>
        <div class="eyebrow">{{ ui.contact }}</div>
        <h2>{{ ui.find_us }}</h2>
        <dl>
          {% if kit.address %}<div><dt>{{ ui.find_us }}</dt><dd>{{ kit.address }}</dd></div>{% endif %}
          {% if kit.phone %}<div><dt>{{ ui.call }}</dt><dd><a href="tel:{{ kit.phone|replace(' ', '') }}">{{ kit.phone }}</a></dd></div>{% endif %}
          {% if kit.email %}<div><dt>{{ ui.write }}</dt><dd><a href="mailto:{{ kit.email }}">{{ kit.email }}</a></dd></div>{% endif %}
          {% if kit.instagram %}<div><dt>Instagram</dt><dd>{{ kit.instagram }}</dd></div>{% endif %}
        </dl>
        <p style="margin-top:28px"><a class="btn" href="{{ 'tel:' ~ kit.phone|replace(' ', '') if kit.phone else 'mailto:' ~ (kit.email or '') }}">{{ copy.cta }}</a></p>
      </div>
      {% if map_query %}
      <iframe class="map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        src="https://www.google.com/maps?q={{ map_query|urlencode }}&output=embed" title="{{ ui.find_us }}"></iframe>
      {% endif %}
    </div>
  </section>
</main>

<footer>
  <div class="wrap">© {{ year }} {{ kit.name }} · {{ kit.city }}</div>
</footer>
</body>
</html>
